# All supported variables. Copy to .env.local to override the defaults from .env.
# Only variables prefixed with VITE_ are exposed to the client — never put secrets here.

# Application title shown in the header and <title>
VITE_APP_TITLE=Расписание

# Base URL for the HTTP client (src/shared/api)
VITE_API_URL=/api

# Firebase Realtime Database sync for the guest screen (optional; leave empty to stay local).
# The web config is public by design; access is limited by database.rules.json and the secret household id.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Published site address; invite and guest links created on localhost point here
VITE_PUBLIC_URL=https://leaderdsn.github.io/life-tracker-planner/
