{
  "rules": {
    "households": {
      ".read": false,
      ".write": false,
      "$h": {
        ".read": "auth != null && $h.length >= 22",
        ".write": "auth != null && $h.length >= 22"
      }
    },
    "interviewPrep": {
      ".read": false,
      ".write": false,
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "schoolPrep": {
      ".read": false,
      ".write": false,
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "content": {
        ".read": true,
        "$gradeId": {
          ".write": "auth != null && root.child('schoolPrep/admins').child(auth.uid).val() === true"
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
